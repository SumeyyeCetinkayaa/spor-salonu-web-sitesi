@model IEnumerable<FitnessCenter.Models.Appointment>

@{
    ViewData["Title"] = "Randevularım";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* GENEL SAYFA AYARLARI */
    body {
        background-color: #000; /* Arka plan tam siyah */
        color: #fff;
    }

    /* ÜST BAŞLIK ALANI */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        border-bottom: 1px solid #333;
        padding-bottom: 20px;
    }

    .page-title h1 {
        font-family: 'Oswald', sans-serif;
        font-size: 2.5rem;
        font-weight: 700;
        color: #dc3545; /* Fitness Kırmızısı */
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .page-title p {
        color: #aaa;
        margin: 5px 0 0 0;
        font-size: 0.95rem;
    }

    /* YENİ RANDEVU BUTONU */
    .btn-new-appointment {
        background-color: #dc3545;
        color: white;
        font-weight: bold;
        padding: 10px 25px;
        border-radius: 5px;
        text-decoration: none;
        text-transform: uppercase;
        transition: all 0.3s ease;
        display: inline-block;
    }

    .btn-new-appointment:hover {
        background-color: #b02a37;
        color: #fff;
        transform: translateY(-2px);
    }

    /* RANDEVU KARTLARI LİSTESİ */
    .appointment-list {
        background-color: #1a1a1a; /* Koyu gri zemin */
        border-radius: 10px;
        padding: 20px;
        border: 1px solid #333;
    }

    .appointment-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background-color: #252525; /* Kart rengi */
        padding: 20px;
        margin-bottom: 15px;
        border-radius: 8px;
        transition: transform 0.2s ease;
        border-left: 5px solid transparent; /* Sol kenar çizgisi için hazırlık */
    }

    .appointment-item:hover {
        transform: translateX(5px);
        background-color: #2a2a2a;
    }

    /* SOL TARAFTAKİ İKON VE İSİM */
    .trainer-info {
        display: flex;
        align-items: center;
        gap: 15px;
        flex: 2; /* Genişlik payı */
    }

    .trainer-icon {
        width: 50px;
        height: 50px;
        background-color: #dc3545;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.2rem;
    }

    .trainer-name {
        font-weight: bold;
        font-size: 1.1rem;
        color: #fff;
        display: block;
    }

    /* ORTA KISIM: BRANŞ VE TARİH */
    .service-badge {
        background-color: #333;
        color: #ccc;
        padding: 5px 15px;
        border-radius: 4px;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-right: 30px;
        white-space: nowrap;
    }

    .date-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .date-main {
        color: #fff;
        font-weight: 600;
        font-size: 1rem;
    }

    .date-time {
        color: #888;
        font-size: 0.85rem;
        margin-top: 3px;
    }

    /* SAĞ KISIM: DURUM ETİKETLERİ */
    .status-badge {
        padding: 8px 20px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: bold;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-width: 130px;
        justify-content: center;
    }

    /* Durumlara göre renkler */
    .status-approved {
        background-color: #198754; /* Yeşil */
        color: white;
    }

    .status-pending {
        background-color: #ffc107; /* Sarı */
        color: #000;
    }

    .status-rejected {
        background-color: #dc3545; /* Kırmızı */
        color: white;
    }

    /* BOŞ LİSTE UYARISI */
    .empty-state {
        text-align: center;
        padding: 50px;
        color: #777;
    }
</style>

<div class="container mt-5">

    <div class="page-header">
        <div class="page-title">
            <h1>Randevularım</h1>
            <p>Geçmiş ve gelecek antrenman programınız.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn-new-appointment">
                + Yeni Randevu
            </a>
        </div>
    </div>

    <div class="appointment-list">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <h4>Henüz hiç randevunuz yok.</h4>
                <p>Sağ üstteki butona tıklayarak ilk antrenmanınızı planlayın!</p>
            </div>
        }
        else
        {
            @foreach (var item in Model.OrderByDescending(x => x.StartTime))
            {
                // Duruma göre CSS sınıfı ve metin belirleme
                string statusClass = "";
                string statusText = "";
                string iconHtml = "";

                switch (item.Status)
                {
                    case FitnessCenter.Models.AppointmentStatus.Approved:
                        statusClass = "status-approved";
                        statusText = "ONAYLANDI";
                        iconHtml = "✓"; // Tik işareti
                        break;
                    case FitnessCenter.Models.AppointmentStatus.Pending:
                        statusClass = "status-pending";
                        statusText = "BEKLEMEDE";
                        iconHtml = "⏳"; // Kum saati
                        break;
                    case FitnessCenter.Models.AppointmentStatus.Rejected:
                        statusClass = "status-rejected";
                        statusText = "REDDEDİLDİ";
                        iconHtml = "✕"; // Çarpı işareti
                        break;
                }

                <div class="appointment-item">

                    <div class="trainer-info">
                        <div class="trainer-icon">
                            <i class="bi bi-person-fill"></i> <span>👤</span>
                        </div>
                        <div>
                            <span class="trainer-name">@item.Trainer.FirstName @item.Trainer.LastName</span>
                            <span style="font-size:0.8rem; color:#aaa;">Eğitmen</span>
                        </div>
                    </div>

                    <div style="display:flex; align-items:center; flex:2;">
                        <div class="service-badge">
                            @item.Service.Name
                        </div>

                        <div class="date-info">
                            <span class="date-main">@item.StartTime.ToString("dd MMMM yyyy")</span>
                            <span class="date-time">
                                @item.StartTime.ToString("HH:mm") - @item.EndTime.ToString("HH:mm")
                            </span>
                        </div>
                    </div>

                    <div>
                        <span class="status-badge @statusClass">
                            <span>@iconHtml</span> @statusText
                        </span>
                    </div>

                </div>
            }
        }
    </div>
</div>