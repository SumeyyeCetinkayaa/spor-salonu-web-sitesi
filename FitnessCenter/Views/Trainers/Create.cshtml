@model FitnessCenter.Models.Trainer

@{
    ViewData["Title"] = "Yeni Eğitmen Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card bg-dark text-white border-secondary shadow-lg">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title text-uppercase fw-bold mb-0">
                        <i class="bi bi-person-plus-fill"></i> Yeni Eğitmen Ekle
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label text-white-50">Ad</label>
                                <input asp-for="FirstName" class="form-control bg-dark text-white border-secondary" placeholder="Örn: Talha" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label text-white-50">Soyad</label>
                                <input asp-for="LastName" class="form-control bg-dark text-white border-secondary" placeholder="Örn: Selçuk" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label text-white-50">E-Posta</label>
                                <input asp-for="Email" class="form-control bg-dark text-white border-secondary" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Phone" class="form-label text-white-50">Telefon</label>
                                <input asp-for="Phone" class="form-control bg-dark text-white border-secondary" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Specialization" class="form-label text-white-50">Uzmanlık Alanı</label>
                            <input asp-for="Specialization" class="form-control bg-dark text-white border-secondary" placeholder="Örn: Kick Boks, Fitness..." />
                            <span asp-validation-for="Specialization" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Bio" class="form-label text-white-50">Biyografi</label>
                            <textarea asp-for="Bio" class="form-control bg-dark text-white border-secondary" rows="4"></textarea>
                            <span asp-validation-for="Bio" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input bg-dark border-secondary" asp-for="IsActive" />
                            <label class="form-check-label text-white" asp-for="IsActive">
                                Bu eğitmen şu an aktif mi?
                            </label>
                        </div>

                        <div class="d-grid gap-2">
                            <input type="submit" value="KAYDET" class="btn btn-danger btn-lg fw-bold" />
                            <a asp-action="Index" class="btn btn-outline-light">Listeye Dön</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}