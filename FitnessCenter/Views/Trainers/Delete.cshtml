@model FitnessCenter.Models.Trainer

@{
    ViewData["Title"] = "Eğitmeni Sil";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // --- RESİM EŞLEŞTİRME MANTIĞI ---
    string resimDosyasi = "default-user.png";

    if (Model.FirstName.Contains("Talha")) { resimDosyasi = "talha.png"; }
    else if (Model.FirstName.Contains("Erkan")) { resimDosyasi = "erkan.png"; }
    else
    {
        var hocaResimleri = new Dictionary<string, string>
        {
            { "Derya", "derya.png" }, { "Doğan", "dogan.png" }, { "Adil", "adil.png" },
            { "Açelya", "acelya.png" }, { "Cansu", "cansu.png" }, { "Zafer", "zafer.png" },
            { "Fikriye", "fikriye.png" }, { "Zehra", "zehra.png" }, { "Sertap", "sertap.png" },
            { "Eda", "eda.png" }
        };

        if (hocaResimleri.ContainsKey(Model.FirstName))
        {
            resimDosyasi = hocaResimleri[Model.FirstName];
        }
    }
}

<div class="container mt-5">
    <div class="alert alert-danger text-center" role="alert">
        <h4 class="alert-heading fw-bold">DİKKAT!</h4>
        <p>Bu eğitmeni silmek istediğinize emin misiniz? Bu işlem geri alınamaz.</p>
    </div>

    <div class="card bg-dark text-white border-danger shadow-lg mx-auto" style="max-width: 800px;">
        <div class="row g-0">
            <div class="col-md-4">
                <img src="~/images/trainers/@resimDosyasi"
                     class="img-fluid rounded-start h-100"
                     style="object-fit: cover;"
                     alt="@Model.FirstName">
            </div>
            <div class="col-md-8">
                <div class="card-body p-4">
                    <h3 class="card-title fw-bold">@Model.FirstName @Model.LastName</h3>
                    <p class="text-danger fw-bold">@Model.Specialization</p>
                    <p class="card-text">@Model.Bio</p>

                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger btn-lg w-100">EVET, SİL</button>
                        <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">İptal</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>