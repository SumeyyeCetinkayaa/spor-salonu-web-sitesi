@model FitnessCenter.Models.Trainer

@{
    ViewData["Title"] = "Eğitmen Detayı";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // --- RESİM EŞLEŞTİRME MANTIĞI ---
    string resimDosyasi = "default-user.png";

    // Manuel kontrol (Garanti olsun diye)
    if (Model.FirstName.Contains("Talha")) { resimDosyasi = "talha.png"; }
    else if (Model.FirstName.Contains("Erkan")) { resimDosyasi = "erkan.png"; }
    else
    {
        // Diğerleri için sözlük
        var hocaResimleri = new Dictionary<string, string>
        {
            { "Derya", "derya.png" }, { "Doğan", "dogan.png" }, { "Adil", "adil.png" },
            { "Açelya", "acelya.png" }, { "Cansu", "cansu.png" }, { "Zafer", "zafer.png" },
            { "Fikriye", "fikriye.png" }, { "Zehra", "zehra.png" }, { "Sertap", "sertap.png" },
            { "Eda", "eda.png" }
        };

        if (hocaResimleri.ContainsKey(Model.FirstName))
        {
            resimDosyasi = hocaResimleri[Model.FirstName];
        }
    }
}

<div class="container mt-5">
    <div class="card bg-dark text-white border-secondary shadow-lg">
        <div class="row g-0">
            <div class="col-md-4">
                <img src="~/images/trainers/@resimDosyasi"
                     class="img-fluid rounded-start h-100"
                     style="object-fit: cover; min-height: 400px;"
                     alt="@Model.FirstName">
            </div>

            <div class="col-md-8">
                <div class="card-body p-5">
                    <h5 class="card-title text-danger text-uppercase fw-bold mb-1">
                        @Html.DisplayFor(model => model.Specialization)
                    </h5>
                    <h1 class="display-4 fw-bold mb-4" style="font-family: 'Oswald', sans-serif;">
                        @Model.FirstName @Model.LastName
                    </h1>

                    <div class="mb-4">
                        <h5 class="text-white-50 border-bottom border-secondary pb-2">Hakkında</h5>
                        <p class="card-text lead">@Model.Bio</p>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-white-50">E-Posta</h6>
                            <p>@Model.Email</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-white-50">Telefon</h6>
                            <p>@Model.Phone</p>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-light px-4">Listeye Dön</a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning px-4">Düzenle</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>