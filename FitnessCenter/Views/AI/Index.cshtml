@model FitnessCenter.Models.AIRecommendationViewModel

@{
    ViewData["Title"] = "Yapay Zeka Antrenör";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* FORM ALANI TASARIMI */
    .ai-card {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    .form-label {
        color: #bbb;
        font-size: 0.9rem;
        margin-bottom: 5px;
    }

    .form-control, .form-select {
        background-color: #252525;
        border: 1px solid #444;
        color: #fff;
        padding: 12px;
        border-radius: 6px;
    }

        .form-control:focus, .form-select:focus {
            background-color: #2a2a2a;
            border-color: #dc3545;
            box-shadow: 0 0 10px rgba(220, 53, 69, 0.2);
            color: white;
        }

    .result-area {
        background-color: #252525;
        border-left: 4px solid #dc3545;
        min-height: 400px;
        padding: 30px;
        border-radius: 8px;
        color: #e0e0e0;
        font-size: 1rem;
        line-height: 1.7;
    }

    .loading-overlay {
        display: none;
        text-align: center;
        padding: 50px;
    }

    .spinner-border {
        width: 3rem;
        height: 3rem;
        color: #dc3545;
    }
</style>

<div class="container my-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-uppercase" style="font-family: 'Oswald', sans-serif;">
            AI <span class="text-danger">PERSONAL TRAINER</span>
        </h1>
        <p class="lead text-white-50">Vücut analizinize göre %100 kişiselleştirilmiş program.</p>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="ai-card p-4 h-100">
                <h4 class="text-white fw-bold mb-4 border-bottom border-secondary pb-2">
                    <i class="bi bi-sliders"></i> Vücut Analizi
                </h4>

                <form id="aiForm" method="post" asp-controller="AI" asp-action="Index">

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="Age" class="form-label"></label>
                            <input asp-for="Age" class="form-control" placeholder="25" />
                            <span asp-validation-for="Age" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Gender" class="form-label"></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="Erkek">Erkek</option>
                                <option value="Kadın">Kadın</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="HeightCm" class="form-label"></label>
                            <input asp-for="HeightCm" class="form-control" placeholder="180" />
                            <span asp-validation-for="HeightCm" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="WeightKg" class="form-label"></label>
                            <input asp-for="WeightKg" class="form-control" placeholder="80" />
                            <span asp-validation-for="WeightKg" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ActivityLevel" class="form-label"></label>
                        <select asp-for="ActivityLevel" class="form-select">
                            <option value="Hareketsiz">Hareketsiz (Masa başı)</option>
                            <option value="Az Hareketli">Az Hareketli (1-2 gün spor)</option>
                            <option value="Orta">Orta (3-4 gün spor)</option>
                            <option value="Çok Hareketli">Çok Hareketli (Her gün)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Goal" class="form-label"></label>
                        <select asp-for="Goal" class="form-select">
                            <option value="Kilo Vermek">Kilo Vermek (Yağ Yakımı)</option>
                            <option value="Kas Kütlesi Kazanmak">Kas Kütlesi Kazanmak</option>
                            <option value="Fit Olmak">Fit ve Sıkı Olmak</option>
                            <option value="Kondisyon">Kondisyon Arttırmak</option>
                        </select>
                        <span asp-validation-for="Goal" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HealthIssues" class="form-label"></label>
                        <textarea asp-for="HealthIssues" class="form-control" rows="2" placeholder="Örn: Bel fıtığı, diz ağrısı..."></textarea>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" id="btnSubmit" class="btn btn-danger fw-bold py-3 text-uppercase">
                            PROGRAMI OLUŞTUR <i class="bi bi-magic"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="ai-card p-4 h-100">
                <h4 class="text-white fw-bold mb-4 border-bottom border-secondary pb-2">
                    <i class="bi bi-robot"></i> Yapay Zeka Önerisi
                </h4>

                <div id="loadingArea" class="loading-overlay">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3 text-muted">Vücut analizin yapılıyor, program hazırlanıyor...</p>
                </div>

                <div id="resultContent" class="result-area">
                    @if (!string.IsNullOrEmpty(ViewBag.Recommendation))
                    {
                        @Html.Raw(ViewBag.Recommendation)
                    }
                    else if (!string.IsNullOrEmpty(Model.RecommendationText))
                    {
                        @Html.Raw(Model.RecommendationText)
                    }
                    else
                    {
                        <p class="text-muted text-center mt-5">
                            <i class="bi bi-arrow-left-circle fs-1 d-block mb-3"></i>
                            Sol taraftaki formu doldurup butona bastığınızda,<br>
                            sizin için özel hazırlanmış <strong>Beslenme ve Antrenman</strong> programı burada görünecektir.
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById("aiForm").onsubmit = function() {
        if (!this.checkValidity()) return;
        document.getElementById("btnSubmit").disabled = true;
        document.getElementById("btnSubmit").innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> ANALİZ YAPILIYOR...';
        document.getElementById("resultContent").style.display = "none";
        document.getElementById("loadingArea").style.display = "block";
    };
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}